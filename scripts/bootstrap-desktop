#!/usr/bin/env bash

set -euo pipefail

usage() {
  cat <<'EOF'
Usage: scripts/bootstrap-desktop [--remove]

Adds Homebrew's share directory to XDG_DATA_DIRS for Linux desktop discovery.
The default action is idempotent. --remove reverses only this bootstrap.
EOF
}

action=install
case "${1:-}" in
  "") ;;
  --remove) action=remove ;;
  -h|--help)
    usage
    exit 0
    ;;
  *)
    usage >&2
    exit 2
    ;;
esac

if ! command -v brew >/dev/null 2>&1; then
  printf 'error: Homebrew is not available on PATH\n' >&2
  exit 1
fi

brew_share="$(brew --prefix)/share"
config_dir="${XDG_CONFIG_HOME:-$HOME/.config}/environment.d"
config_file="$config_dir/60-fedora-brew-xdg-data.conf"
default_dirs="/usr/local/share:/usr/share"
current_dirs="${XDG_DATA_DIRS:-$default_dirs}"

remove_path() {
  local input="$1" output="" item
  IFS=: read -r -a items <<< "$input"
  for item in "${items[@]}"; do
    [[ -n "$item" && "$item" != "$brew_share" ]] || continue
    output="${output:+$output:}$item"
  done
  printf '%s' "${output:-$default_dirs}"
}

base_dirs="$(remove_path "$current_dirs")"

if [[ "$action" == remove ]]; then
  if [[ -f "$config_file" ]] && grep -Fqx "XDG_DATA_DIRS=$brew_share:$base_dirs" "$config_file"; then
    rm -f "$config_file"
  fi
  new_dirs="$base_dirs"
  printf 'Removed Fedora Brew desktop bootstrap: %s\n' "$config_file"
else
  mkdir -p "$config_dir"
  new_dirs="$brew_share:$base_dirs"
  tmp_file="$(mktemp "$config_file.XXXXXX")"
  trap 'rm -f "$tmp_file"' EXIT
  printf 'XDG_DATA_DIRS=%s\n' "$new_dirs" > "$tmp_file"
  chmod 0644 "$tmp_file"
  mv -f "$tmp_file" "$config_file"
  trap - EXIT
  printf 'Configured Fedora Brew desktop discovery: %s\n' "$config_file"
fi

if command -v systemctl >/dev/null 2>&1; then
  systemctl --user set-environment "XDG_DATA_DIRS=$new_dirs" 2>/dev/null || true
fi
if command -v dbus-update-activation-environment >/dev/null 2>&1; then
  XDG_DATA_DIRS="$new_dirs" dbus-update-activation-environment --systemd XDG_DATA_DIRS 2>/dev/null || true
fi
if command -v update-desktop-database >/dev/null 2>&1 && [[ -d "$brew_share/applications" ]]; then
  XDG_DATA_DIRS="$new_dirs" update-desktop-database "$brew_share/applications" 2>/dev/null || true
fi
if command -v kbuildsycoca6 >/dev/null 2>&1; then
  XDG_DATA_DIRS="$new_dirs" kbuildsycoca6 --noincremental >/dev/null 2>&1 || true
elif command -v kbuildsycoca5 >/dev/null 2>&1; then
  XDG_DATA_DIRS="$new_dirs" kbuildsycoca5 --noincremental >/dev/null 2>&1 || true
fi
if [[ "${KDE_FULL_SESSION:-}" == true ]] &&
   command -v systemctl >/dev/null 2>&1 &&
   systemctl --user is-active --quiet plasma-plasmashell.service; then
  systemctl --user restart plasma-plasmashell.service
  printf 'Restarted Plasma Shell with the updated desktop search path.\n'
fi

if [[ "$action" == install ]]; then
  printf 'Homebrew applications are indexed and the environment is persistent for future logins.\n'
fi
